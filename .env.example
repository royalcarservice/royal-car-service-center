# GarageAI production environment
APP_ENV=production
PORT=4173
DATABASE_URL=postgresql://garageai:change-me@db:5432/garageai

# Session and application security
SESSION_HOURS=8
GARAGEAI_SECRET=replace-with-a-long-random-secret
APP_PUBLIC_URL=https://garage.example.com

# Messaging
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SMS_FROM=

# Payments: configure Razorpay or Stripe
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Accounting
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REALM_ID=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=

# Vehicle, parts, and maps
NHTSA_API_BASE=https://vpic.nhtsa.dot.gov/api/vehicles
PARTS_SUPPLIER_API_KEY=
GOOGLE_MAPS_API_KEY=
